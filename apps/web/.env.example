# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose to the client. Used by trusted server code that
# must bypass RLS (e.g. batch recalculation jobs). Not required for MVP auth.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — server-only. Powers the "AI EXPLAINS" layer (never calculates).
ANTHROPIC_API_KEY=your-anthropic-key
