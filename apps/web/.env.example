# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose to the client. REQUIRED: login has been removed, so
# all server-side data access runs through this service-role key (it bypasses
# RLS and operates as the single account). The app cannot read/write data
# without it. Set it locally AND in Vercel env.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — server-only. Powers the "AI EXPLAINS" layer (never calculates).
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI — server-only. Used ONLY to transcribe voice reminders (Whisper).
# Optional: without it, voice capture falls back to typing. Audio is sent for
# transcription only and never stored.
OPENAI_API_KEY=your-openai-key
